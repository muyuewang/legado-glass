<?xml version="1.0" encoding="utf-8"?>
<!--
  应用图标背景层（自适应图标）。

  [为什么改掉原来的纯灰桌面]
  原图是 #4d4d4d 纯灰底 + 底部两片白/浅灰的"桌面"，那是 Legado 原版的样子，
  装在同一台机器上和原版几乎无法区分。
  这里换成本 App 的暖褐体系：
    · 基底深暖褐，与界面里的深色文字、暖色投影同族；
    · 左上冷白光斑 + 右下暖色光斑，正是 lg_bg_page 那套"有光源的纵深"做法；
    · 去掉桌面那两片色块，让书页直接浮在渐变上 —— 图标本身也有"玻璃浮层"的意思。

  [为什么底色仍要深]
  前景是白色书页和文字线条，压在浅色底上会碎成一片。深底是让前景清晰的必要条件，
  这也符合图标设计的基本约束：图标不是越亮越好，是可辨识度越高越好。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 基底：左上偏亮、右下偏深的暖褐对角渐变 -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:type="linear">
                <item
                    android:color="#FF4A403A"
                    android:offset="0" />
                <item
                    android:color="#FF3A322C"
                    android:offset="0.55" />
                <item
                    android:color="#FF2B2521"
                    android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 左上冷白光斑：模拟光线从屏幕左上方打进来 -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="22"
                android:centerY="10"
                android:gradientRadius="76"
                android:type="radial">
                <item
                    android:color="#4DFFFFFF"
                    android:offset="0" />
                <item
                    android:color="#14FFFFFF"
                    android:offset="0.55" />
                <item
                    android:color="#00FFFFFF"
                    android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 右下暖色光斑：与页面背景里的暖褐光斑呼应，避免整块发死 -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="98"
                android:centerY="104"
                android:gradientRadius="66"
                android:type="radial">
                <item
                    android:color="#33D9B48A"
                    android:offset="0" />
                <item
                    android:color="#00D9B48A"
                    android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

</vector>