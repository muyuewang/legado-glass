<?xml version="1.0" encoding="utf-8"?>
<!--
  液态玻璃设计变量层（浅色）

  [为什么要独立一份，而不是塞进 colors.xml]
  原 colors.xml 里有 120 多个颜色，被 257 个布局引用，直接改会牵连全局。
  这份只放玻璃材质自己的变量，命名统一 lg_ 前缀，与原体系互不干扰，
  夜间版放在 values-night/lg_colors.xml，改主题只需换这两份文件。

  数值来源：readbook 项目已定型的 liquid-glass.css（其中的 lg_ 系列变量），
  两边保持同一套视觉语言，避免"两个 App 两种玻璃"。
-->
<resources>

    <!-- ============================================================ 页面底色 -->
    <!-- 玻璃需要"后面有东西"才显得出材质，纯白底上看不出层次 -->
    <color name="lg_page">#F3EAE0</color>
    <color name="lg_page_2">#EFE4D8</color>
    <color name="lg_page_deep">#E9DCCD</color>

    <!-- ============================================================ 玻璃本体 -->
    <!--
      tint：玻璃自身的着色调。

      [透明度是算出来的，不是调出来的]
      最终不透明度 = 1 - (1-tint)(1-sheen)，两层白色会累加。
      上一版 tint 58% + 顶光 42% → 1-0.42×0.58 = 76%，
      几乎等于不透明，所以"根本看不到下面的背景"。
      现在 tint 压到 26%，顶光压到 16% → 1-0.74×0.84 = 38%，
      剩下 62% 全靠背后的模糊层透出来，这才是玻璃该有的透光率。
    -->
    <!--
      [第二轮：整体降透光]

      上一版 27% / 26% / 14% 是"能透多少就透多少"的取向，
      实际观感偏轻飘：Dock 浮在封面上时，背后书名的笔画仍能辨认，
      标题栏压在列表上能看见行文字影，玻璃更像"磨砂贴纸"而不是有厚度的板。

      本轮统一提 alpha（= 降透明度），三档各提高一倍左右：
        · tint       27% → 52%，合成 1-(1-0.52)(1-0.16) ≈ 60%
        · strong     26% → 50%，Dock 专用，合成 ≈ 58%
        · soft       14% → 30%，标题栏专用，合成 ≈ 41%
      soft 仍比 strong 轻，是因为标题栏下方紧接着正文/列表，
      做得太实会把页面纵深切碎；它靠"下沿一道亮边"交代边界，不靠厚度。
    -->
    <color name="lg_glass_tint">#85FFFFFF</color>          <!-- 52% 白 -->
    <color name="lg_glass_tint_strong">#80FFFFFF</color>   <!-- 50% 白 -->
    <color name="lg_glass_tint_soft">#4DFFFFFF</color>     <!-- 30% 白 -->

    <!--
      弹层专用 tint（对话框 / 弹出菜单）。

      [弹层不能沿用 Dock 的 27%]
      两者的文字处境完全不同：
        · Dock —— 文字在玻璃**外**，玻璃只是背景，越透越好看；
        · 对话框 —— 文字**就画在玻璃上**，且背后是变暗的复杂页面。
      Dock 那档透光率下，对话框标题会和背后的列表行叠在一起，直接读不清。

      [本文件是 API 31 以下的"无模糊档"，所以取 94%]
      液态玻璃之所以"透而可读"，关键不在透明度，而在**背后被柔化了**：
      模糊把文字、图标糊成色块，透出来只有明暗、没有细节，不干扰阅读。
      而 API 31 以下拿不到跨窗口 backdrop，透出来的是**清晰的文字边缘** ——
      实测在 API 28 上，72% 会让背后"书架空空如也…"的提示语直接穿进弹窗正文，
      可读性比原来的实色还差。

      [有模糊的那一档在 values-v31/lg_colors.xml]
      那里是 72%（合成约 76% 不透明，留 24% 真实透光），
      由资源限定符自动选择，代码层不做版本判断。
    -->
    <color name="lg_glass_tint_panel">#F7FFFFFF</color>    <!-- 97% 白，无模糊档 -->

    <!-- 弹出菜单比对话框再实一点：菜单项字号小、行数密，透太多会串行 -->
    <color name="lg_glass_tint_menu">#FAFFFFFF</color>     <!-- 98% 白，无模糊档 -->

    <!--
      [条栏专用档：99%]

      为什么单开一档，而不是复用 panel：
      阅读页的顶部/底部条栏叠在**密集的黑色正文**上，这是全 App 最恶劣的透光场景 ——
      列表页背后是大片留白，透一点没关系；正文是满屏字。

      [为什么 97% 也不够，必须到 99%]
      纯色叠加的计算是：结果 = 255 - (255-正文色)×(1-alpha)。
      正文是近黑（约 #1A1A1A），代入：
        · 94%（panel）→ 结果 ≈ 241，与纯白差 14 个色阶 —— 字形轮廓清晰可辨，直接叠字；
        · 97%          → 结果 ≈ 248，差 7 个色阶 —— 仍是"隐约看见一行行灰影"；
        · 99%（本档）  → 结果 ≈ 253，差 2 个色阶 —— 低于人眼在移动端的分辨阈值。
      这就是上一轮把 97% 铺上去、实机仍能看到"不过人类从来没有放弃过探索"
      穿进底部工具栏的原因：**不是档位没生效，是 97% 这个数本身不够**。

      [为什么不能只靠模糊解决]
      这类条栏是 Activity 内的普通 View，拿不到跨窗口 backdrop（那是 API 31+ 的
      Window.setBackgroundBlurRadius），也就没有"背后被柔化"这个前提。
      没有模糊时透出来的是**清晰文字边缘**，透多少就看得见多少，
      只能靠不透明度本身解决可读性 —— 这是降级路径必须付出的代价。

      [材质感改由边框与内高光承担]
      tint 几乎不透之后，"这是一块玻璃"的线索只剩下：
      上沿那道 92% 白的线、四周 92% 的描边、以及顶光的极淡渐变。
      实测这三层还在，观感是"一块有厚度的磨砂白板"，不会退化成纯色矩形。
    -->
    <color name="lg_glass_tint_bar">#FCFFFFFF</color>      <!-- 99% 白 -->

    <!--
      border：玻璃边缘那道亮线，是"玻璃感"的主要来源之一。

      [玻璃越透，边框越要硬]
      透明度降下来之后，轮廓只能靠边框撑住，否则整块会"化"进背景里。
      92% 的白边正是这块玻璃"能看出是个实体"的唯一依据。
    -->
    <color name="lg_glass_border">#EBFFFFFF</color>        <!-- 92% 白 -->
    <color name="lg_glass_border_soft">#6BFFFFFF</color>   <!-- 42% 白 -->

    <!-- 内高光：上沿最亮、下沿次之、左右收一点，模拟光线穿过玻璃厚度 -->
    <color name="lg_hi_top">#EBFFFFFF</color>              <!-- 92% 白 -->
    <color name="lg_hi_bottom">#47FFFFFF</color>           <!-- 28% 白 -->
    <color name="lg_hi_side">#6BFFFFFF</color>             <!-- 42% 白 -->

    <!--
      顶光渐变：从左上往右下衰减，给玻璃一点体积感。

      [这一层是压住背景的第二元凶]
      它覆盖整个玻璃面板，起始 42% 白。和 tint 叠乘之后，
      左上角区域几乎是实白的 —— 所以"根本看不到下面的背景"。
      现在起始压到 16%、中段 5%，只保留一点方向性的微光，
      不再承担"让玻璃变白"的职责（那是 tint 的事）。
    -->
    <color name="lg_sheen_start">#29FFFFFF</color>         <!-- 16% 白 -->
    <color name="lg_sheen_mid">#0DFFFFFF</color>           <!-- 5% 白 -->
    <color name="lg_sheen_end">#00FFFFFF</color>           <!-- 全透明 -->

    <!-- ============================================================ 阴影 -->
    <!--
      [刻意不用纯黑] 纯黑投影在暖色底上会发脏发灰，实测明显。
      改用偏暖的深褐（120,96,72），与页面米色调同族，落下更自然。

      [浓度从 5/9/6% 提到 10/13/9%]
      原来的浓度是为深色底调的，落在暖米色上几乎不可见 ——
      截图里 Dock 看着像"贴"在页面上，没有浮起来的感觉。
      暖米底比深底更能吃掉暗色，所以必须加倍。
    -->
    <color name="lg_shadow_1">#1A786048</color>            <!-- 10% -->
    <color name="lg_shadow_2">#21786048</color>            <!-- 13% -->
    <color name="lg_shadow_3">#17786048</color>            <!-- 9% -->

    <color name="lg_shadow_lift_1">#14786048</color>       <!-- 8% -->
    <color name="lg_shadow_lift_2">#24786048</color>       <!-- 14% -->
    <color name="lg_shadow_lift_3">#1A786048</color>       <!-- 10% -->

    <!-- ============================================================ 文字 -->
    <color name="lg_text">#2B2825</color>
    <color name="lg_text_2">#6F6862</color>
    <color name="lg_text_3">#9A938C</color>
    <color name="lg_text_inv">#FFFFFF</color>

    <!-- ============================================================ 强调色 -->
    <color name="lg_accent">#2FBFB0</color>
    <color name="lg_accent_ink">#FFFFFF</color>
    <color name="lg_blue">#4A90E2</color>
    <color name="lg_danger">#E5645C</color>

    <!-- 分隔线 -->
    <color name="lg_sep">#1F786450</color>                 <!-- 12% -->

    <!-- 降级用实底：设备不支持模糊时，靠高不透明度保证文字可读 -->
    <color name="lg_fallback_solid">#F2EFE4D8</color>

    <!-- ============================================================ 尺寸 -->
    <dimen name="lg_r_xs">10dp</dimen>
    <dimen name="lg_r_sm">14dp</dimen>
    <dimen name="lg_r_md">20dp</dimen>
    <dimen name="lg_r_lg">26dp</dimen>
    <dimen name="lg_r_xl">32dp</dimen>

    <!--
      [模糊半径与降采样倍率是一组联调参数]
      GlassPanel 实际传给 stackBlur 的半径是 blurRadius / blurDownscale。
      早期用 8dp + 2 倍降采样，等于在 328x56 的位图上只糊 8px ——
      字形的笔画间距大于 8px，糊完仍然轮廓清晰可辨，观感像"贴了张半透明纸"
      而不是"毛玻璃"。
      改成 18dp + 1 倍降采样（原图 656x112，半径 36px）后，
      笔画间距被核宽度覆盖，背后内容塌成柔和的明暗块，
      这才是 backdrop-filter 的观感。
      代价：像素量约为原来的 4 倍，单次约 3~5ms；只在布局变化与滚动停止时刷新，不影响帧率。
    -->
    <dimen name="lg_blur">18dp</dimen>
    <dimen name="lg_blur_sm">13dp</dimen>

    <!-- 带玻璃效果的底栏高度（比原 50dp 略高，容纳圆角悬浮形态） -->
    <dimen name="lg_dock_height">64dp</dimen>
    <dimen name="lg_dock_margin">12dp</dimen>
    <dimen name="lg_dock_inset">6dp</dimen>

    <!-- 边框线宽。1dp 在高分屏上偏粗，玻璃的边要"细而亮" -->
    <dimen name="lg_border_width">1dp</dimen>
    <!-- 内高光发丝线，比边框更细，只做明暗提示 -->
    <dimen name="lg_hairline">1dp</dimen>
    <!-- 投影外扩量：三层同心圆角最外层的扩散距离 -->
    <dimen name="lg_shadow_spread">10dp</dimen>

</resources>